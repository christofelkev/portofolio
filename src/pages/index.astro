---
import MainLayout from '../layouts/MainLayout.astro';
import Header from '../components/Header.astro';
import HeroProfile from '../components/HeroProfile.astro';
import AboutSection from '../components/AboutSection.astro';
import ProjectsSection from '../components/ProjectsSection.astro';
import ExperienceSection from '../components/ExperienceSection.astro';
import ContactSection from '../components/ContactSection.astro';
import Footer from '../components/Footer.astro';
import i18nData from '../data/i18n.json';
import projectsData from '../data/projects.json';

const i18nJson = JSON.stringify(i18nData);
const projectsJson = JSON.stringify(projectsData);
---

<MainLayout>
  <Header />
  <main>
    <HeroProfile />
    <AboutSection />
    <ProjectsSection />
    <ExperienceSection />
    <ContactSection />
  </main>
  <Footer />

  <script is:inline define:vars={{ i18n: i18nJson, projects: projectsJson }}>
    var __I18N__ = JSON.parse(i18n);
    var __PROJECTS__ = JSON.parse(projects);

    // --- Theme Controller ---
    function initTheme() {
      var moonIcon = document.getElementById('theme-icon-moon');
      var sunIcon = document.getElementById('theme-icon-sun');

      function updateThemeIcons(isLight) {
        if (moonIcon && sunIcon) {
          moonIcon.style.display = isLight ? 'none' : 'block';
          sunIcon.style.display = isLight ? 'block' : 'none';
        }
      }

      var isLightInit = document.documentElement.classList.contains('light');
      updateThemeIcons(isLightInit);

      var toggleBtn = document.getElementById('theme-toggle');
      if (toggleBtn) {
        toggleBtn.addEventListener('click', function() {
          var isLight = document.documentElement.classList.toggle('light');
          localStorage.setItem('theme', isLight ? 'light' : 'dark');
          updateThemeIcons(isLight);
        });
      }
    }

    // --- i18n Controller (EN / ID) ---
    function initI18n() {
      var currentLang = localStorage.getItem('lang') || 'id';

      function applyTranslations(lang) {
        document.documentElement.lang = lang;
        var dict = __I18N__[lang];
        if (!dict) return;

        // Translate data-i18n elements
        document.querySelectorAll('[data-i18n]').forEach(function(el) {
          var key = el.getAttribute('data-i18n');
          if (!key) return;

          try {
            var parts = key.split('.');
            var val = dict;
            for (var i = 0; i < parts.length; i++) {
              if (val && typeof val === 'object') {
                val = val[parts[i]];
              } else {
                val = null;
                break;
              }
            }
            if (val && typeof val === 'string') {
              el.textContent = val;
            }
          } catch(e) {}
        });

        // Update Project Card Titles & Descriptions
        var projectCards = document.querySelectorAll('.project-card');
        projectCards.forEach(function(card, idx) {
          var p = __PROJECTS__[idx];
          if (!p) return;
          var titleEl = card.querySelector('.card-title a');
          var descEl = card.querySelector('.card-desc');
          if (titleEl && p.title) {
            titleEl.textContent = p.title[lang] || p.title.id;
          }
          if (descEl && p.description) {
            descEl.textContent = p.description[lang] || p.description.id;
          }
        });

        // Update Lang Button Label
        var langLabel = document.getElementById('lang-label');
        if (langLabel) {
          langLabel.textContent = lang === 'id' ? 'EN' : 'ID';
        }

        localStorage.setItem('lang', lang);
      }

      var langBtn = document.getElementById('lang-toggle');
      if (langBtn) {
        langBtn.addEventListener('click', function() {
          var cur = localStorage.getItem('lang') || 'id';
          var next = cur === 'id' ? 'en' : 'id';
          applyTranslations(next);
        });
      }

      applyTranslations(currentLang);
    }

    // --- Email Copy Action ---
    function initCopyEmail() {
      var copyBtn = document.getElementById('copy-email-btn');
      var copyText = document.getElementById('copy-text');
      if (!copyBtn || !copyText) return;

      copyBtn.addEventListener('click', function() {
        var email = copyBtn.getAttribute('data-email');
        if (!email) return;

        var lang = localStorage.getItem('lang') || 'id';
        var copiedLabel = (__I18N__[lang] && __I18N__[lang].contact && __I18N__[lang].contact.copied) || 'Copied!';
        var defaultLabel = (__I18N__[lang] && __I18N__[lang].contact && __I18N__[lang].contact.copyEmail) || 'Copy Address';

        navigator.clipboard.writeText(email).then(function() {
          copyText.textContent = copiedLabel;
          copyBtn.style.borderColor = 'var(--primary)';
          copyBtn.style.color = 'var(--primary)';
          setTimeout(function() {
            copyText.textContent = defaultLabel;
            copyBtn.style.borderColor = '';
            copyBtn.style.color = '';
          }, 2000);
        }).catch(function() {
          window.location.href = 'mailto:' + email;
        });
      });
    }

    // Initialize all controllers
    initTheme();
    initI18n();
    initCopyEmail();
  </script>
</MainLayout>
