---
import i18nData from '../data/i18n.json';
import projectsData from '../data/projects.json';

const lang = 'id';
const t = i18nData[lang];
const { projects: pt } = t;
---

<section class="section" id="projects">
  <div class="container">
    <h2 class="section-heading">
      <span class="section-num" data-i18n="projects.sectionNum">{pt.sectionNum}</span>
      <span class="section-sep">·</span>
      <span class="section-title" data-i18n="projects.title">{pt.title}</span>
    </h2>

    <div class="projects-grid" id="projects-container">
      {projectsData.map((project) => {
        const title = project.title[lang] || project.title.id;
        const desc = project.description[lang] || project.description.id;
        const hasImg = project.images && project.images.length > 0 && !project.images[0].includes('gif-1.svg');
        const imgSrc = hasImg ? project.images[0] : null;
        const isLive = project.tags.includes('AI') || project.tags.includes('Web App') || project.tags.includes('React');

        return (
          <article class="project-card">
            <!-- Dual-layer visual preview box -->
            <div class="card-preview-box">
              <div class="preview-backdrop"></div>
              <div class="preview-mockup">
                {imgSrc ? (
                  <img src={imgSrc} alt={`${title} preview`} loading="lazy" />
                ) : (
                  <div class="mockup-fallback">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <polyline points="16 18 22 12 16 6"></polyline>
                      <polyline points="8 6 2 12 8 18"></polyline>
                    </svg>
                    <span>{project.tags[0] || 'SOURCE CODE'}</span>
                  </div>
                )}
              </div>
            </div>

            <!-- Content Details -->
            <div class="card-content">
              <div class="card-title-row">
                <h3 class="card-title">
                  <a href={project.repo} target="_blank" rel="noopener noreferrer">
                    {title}
                  </a>
                </h3>
                <span class={`status-pill ${isLive ? 'live' : ''}`}>
                  <span class="status-dot"></span>
                  <span>{isLive ? pt.statusLive : pt.statusRepo}</span>
                </span>
              </div>

              <p class="card-desc">
                {desc}
              </p>

              <!-- Footer: Tags & External Links -->
              <div class="card-footer">
                <div class="card-tags">
                  {project.tags.slice(0, 3).map((tag) => (
                    <span class="tag-badge">{tag}</span>
                  ))}
                </div>

                <div class="card-actions">
                  <a
                    href={project.repo}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="card-action-btn"
                    aria-label={`${title} repository`}
                    title="View GitHub Repository"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                      <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
                    </svg>
                  </a>
                </div>
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>
