---
import i18nData from '../data/i18n.json';

const lang = 'id';
const t = i18nData[lang];
const { hero } = t;
---

<section class="hero-section" id="home">
  <div class="container">
    <!-- Panoramic Banner Cover -->
    <div class="banner-wrapper">
      <img
        src="/assets/banner.png"
        alt="Profile banner"
        class="banner-img"
        loading="eager"
      />
      <div class="banner-overlay"></div>
    </div>

    <!-- Profile Header (Overlapping Avatar + Identity) -->
    <div class="profile-header">
      <div class="avatar-wrapper">
        <img
          src="/assets/avatar.png"
          alt="Christofel Kevin Manopo"
          class="avatar-img"
          loading="eager"
        />
      </div>

      <div class="profile-meta">
        <h1 class="profile-name" data-i18n="hero.name">{hero.name}</h1>
        <p class="profile-sub">
          <span class="handle" data-i18n="hero.handle">{hero.handle}</span>
          <span class="dot-sep">·</span>
          <span class="role" data-i18n="hero.role">{hero.role}</span>
        </p>
      </div>
    </div>

    <!-- Bio Statement -->
    <p class="hero-bio" data-i18n="hero.bio">
      {hero.bio}
    </p>

    <!-- Social Links Row -->
    <div class="social-links">
      <!-- GitHub -->
      <a
        href="https://github.com/christofelkev"
        target="_blank"
        rel="noopener noreferrer"
        class="social-link"
        aria-label="GitHub Profile"
        title="GitHub"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
          <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
        </svg>
      </a>

      <!-- LinkedIn -->
      <a
        href="https://linkedin.com/in/christofel-kevin"
        target="_blank"
        rel="noopener noreferrer"
        class="social-link"
        aria-label="LinkedIn Profile"
        title="LinkedIn"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
          <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
        </svg>
      </a>

      <!-- Email Quick Action -->
      <a
        href="mailto:christofelmanopo3@gmail.com"
        class="social-link"
        aria-label="Send Email"
        title="Email"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
          <polyline points="22,6 12,13 2,6"></polyline>
        </svg>
      </a>

      <!-- Resume Download -->
      <a
        href="/assets/cv/CV.pdf"
        target="_blank"
        rel="noopener noreferrer"
        class="social-link"
        aria-label="View Resume PDF"
        title="Resume PDF"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
          <polyline points="14 2 14 8 20 8"></polyline>
          <line x1="16" y1="13" x2="8" y2="13"></line>
          <line x1="16" y1="17" x2="8" y2="17"></line>
        </svg>
      </a>
    </div>
  </div>
</section>
