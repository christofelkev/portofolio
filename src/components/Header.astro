---
import i18nData from '../data/i18n.json';

const lang = 'id';
const t = i18nData[lang];
const { nav, brandShort, brandFull } = t;
---

<header class="site-header">
  <div class="container">
    <div class="nav-wrapper">
      <!-- Interactive Wordmark (SimoHypers style hover) -->
      <a href="/" class="wordmark-link" aria-label="Home">
        <span class="wordmark-short" data-i18n="brandShort">{brandShort}</span>
        <span class="wordmark-full" data-i18n="brandFull">{brandFull}</span>
      </a>

      <!-- Navigation Links -->
      <nav class="nav-links" aria-label="Main Navigation">
        <a href="#about" class="nav-item" data-i18n="nav.about">{nav.about}</a>
        <a href="#projects" class="nav-item" data-i18n="nav.projects">{nav.projects}</a>
        <a href="#experience" class="nav-item" data-i18n="nav.experience">{nav.experience}</a>
        <a href="#contact" class="nav-item" data-i18n="nav.contact">{nav.contact}</a>
      </nav>

      <!-- Action Group -->
      <div class="nav-actions">
        <!-- Resume / CV Button -->
        <a
          href="/assets/cv/CV.pdf"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-pill"
          aria-label="Download Resume"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
            <polyline points="14 2 14 8 20 8"></polyline>
            <line x1="16" y1="13" x2="8" y2="13"></line>
            <line x1="16" y1="17" x2="8" y2="17"></line>
            <polyline points="10 9 9 9 8 9"></polyline>
          </svg>
          <span data-i18n="nav.resume">{nav.resume}</span>
        </a>

        <!-- Language Switcher Button -->
        <button id="lang-toggle" class="btn-pill" aria-label="Switch language">
          <span id="lang-label" data-i18n="nav.langLabel">{nav.langLabel}</span>
        </button>

        <!-- Theme Toggle Button -->
        <button id="theme-toggle" class="btn-icon" aria-label="Toggle theme" title="Toggle theme">
          <svg id="theme-icon-moon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
          </svg>
          <svg id="theme-icon-sun" style="display:none;" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="5"></circle>
            <line x1="12" y1="1" x2="12" y2="3"></line>
            <line x1="12" y1="21" x2="12" y2="23"></line>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
            <line x1="1" y1="12" x2="3" y2="12"></line>
            <line x1="21" y1="12" x2="23" y2="12"></line>
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
          </svg>
        </button>
      </div>
    </div>
  </div>
</header>
