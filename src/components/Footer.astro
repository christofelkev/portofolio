---
import i18nData from '../data/i18n.json';

const lang = 'id';
const t = i18nData[lang];
const { footer } = t;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-inner">
      <span>
        &copy; {year} <span data-i18n="footer.copyright">{footer.copyright}</span>
      </span>
    </div>
  </div>
</footer>
